{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ESM_URL=http://tower:8765 ESM_AGENT_ID=primary ESM_PROJECT=scutemob bash /home/skydude/projects/esm/hooks/esm-hook-v3.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/start-check.sh --hook",
            "timeout": 45,
            "statusMessage": "Checking CR / Scryfall data freshness"
          }
        ]
      }
    ]
  }
}
